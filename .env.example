# 复制为仓库根目录 .env（勿提交）
# cp .env.example .env

# ── LLM（AI 动态摘要 + 站内助手 + 笔记速览）──
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 生成笔记速览（正文 hash 缓存；prebuild/CI 会自动跑，无 Key 则 --soft 跳过）：
#   npm run summarize:notes
#   npm run summarize:notes -- --only-weak
#   npm run summarize:notes -- --limit=5
# GitHub Actions 需配置 Secret：LLM_API_KEY（可选 LLM_BASE_URL / LLM_MODEL）

# ── 腾讯云 COS（文章配图；本地 ingest / news:images / cos:* 需要）──
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=penn-notes-img-1300329311
# COS_REGION=ap-guangzhou
# COS_CDN_BASE=https://img.penn-notes.draftly.cn

# ── 双托管（一般只在 CI 设置；本地默认 /）──
# PENN_BASE=/
# PENN_BASE=/penn-notes/
# PENN_SITE_URL=https://penn-notes.draftly.cn

# ── Umami 统计（构建时注入；不配则不注入）──
# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=

# ── 百度站长推送（可选；CI 部署后推送）──
# BAIDU_PUSH_TOKEN=
# BAIDU_SITE=https://penn-notes.draftly.cn

# ── 本地助手 ──
# 需 Node >= 20（仓库有 .nvmrc）：nvm use
# 终端 1: npm run assistant:dev
# 终端 2: npm run dev
# VitePress 已把 /api/assistant 反代到下面 HOST:PORT，一般不必设 ASSISTANT_API_BASE
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8787
# 仅当不用本地反代、要直连助手时才设（例如 preview / 跨域调试）：
# ASSISTANT_API_BASE=http://127.0.0.1:8787
# ASSISTANT_ENABLED=true
# ASSISTANT_RATE_MAX=20
# ASSISTANT_RATE_DAILY=80
# ASSISTANT_CORS_ORIGINS=https://lp-Imagine.github.io
# ASSISTANT_INDEX_PATH=

# ── Decap CMS（/admin 在线写笔记；GitHub OAuth）──
# 创建 GitHub OAuth App：Homepage=https://penn-notes.draftly.cn
# Callback=https://penn-notes.draftly.cn/api/decap-auth/callback
# 本地联调可再加一条 Callback=http://localhost:5173/api/decap-auth/callback
# 并把 DECAP_PUBLIC_ORIGIN=http://localhost:5173
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# DECAP_PUBLIC_ORIGIN=https://penn-notes.draftly.cn

# ── 音乐（默认 meting 自研胶囊；可配明月浩空兜底）──
# 改歌单：website/data/music.json
# provider=meting：优先自研胶囊；配置了 MUSIC_MYHKW_PLAYER_ID 时，限流/拉歌失败自动切明月浩空
# provider=myhkw：只用明月浩空浮窗（后台改歌单）
# MUSIC_ENABLED=false
# MUSIC_PROVIDER=meting
# MUSIC_SERVER=tencent
# MUSIC_TYPE=playlist
# MUSIC_PLAYLIST_ID=1567517618
# METING_API=/api/meting
# MUSIC_MYHKW_PLAYER_ID=1618646380121
